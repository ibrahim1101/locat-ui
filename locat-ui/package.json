{
  "name": "locat-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Locat UI kit — Liquid Titanium + Smoked Glass. Standalone React + TypeScript + Vite implementation of the approved Locat design with mock adapters.",
  "scripts": {
    "dev": "vite --port 3002",
    "build": "tsc -b && vite build",
